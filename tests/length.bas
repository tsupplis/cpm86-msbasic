10 REM Run on a scratch disk. Answer 1 for exact byte counts, 0 for record-only.
20 INPUT "Exact lengths (1/0)";E
25 OPEN "R",1,"LENEMPTY.DAT":CLOSE:OPEN "I",1,"LENEMPTY.DAT":S=0:GOSUB 500:IF NOT EOF(1) THEN GOTO 600
26 CLOSE:KILL "LENEMPTY.DAT"
30 FOR I=0 TO 4:READ N:DATA 0,126,127,128,129
40 OPEN "O",1,"LENTEST.DAT":IF N THEN PRINT #1,STRING$(N,"X");
50 CLOSE:OPEN "I",1,"LENTEST.DAT":S=N+1:GOSUB 500
60 IF N THEN IF INPUT$(N,1)<>STRING$(N,"X") THEN GOTO 600
70 IF NOT EOF(1) THEN GOTO 600
80 CLOSE:OPEN "A",1,"LENTEST.DAT":PRINT #1,"Z";:CLOSE
90 OPEN "I",1,"LENTEST.DAT":S=N+2:GOSUB 500
100 IF INPUT$(N+1,1)<>STRING$(N,"X")+"Z" THEN GOTO 600
110 CLOSE:NEXT
120 OPEN "O",1,"LENTEST.DAT":PRINT #1,"X";:CLOSE
130 OPEN "I",1,"LENTEST.DAT":S=2:GOSUB 500:CLOSE
140 DIM A%(64):A%(63)=26:A%(64)=0
150 BSAVE "LENMEM.BIN",VARPTR(A%(0)),130
155 OPEN "I",1,"LENMEM.BIN":S=138:GOSUB 500:CLOSE
160 A%(63)=1:A%(64)=1:BLOAD "LENMEM.BIN",VARPTR(A%(0))
170 IF A%(63)<>26 OR A%(64)<>0 THEN GOTO 600
180 OPEN "R",1,"LENTEST.DAT",128:FIELD #1,128 AS F$
190 LSET F$="R":PUT #1,2:CLOSE
200 OPEN "R",1,"LENTEST.DAT",128:S=256:GOSUB 500:GET #1,2
210 FIELD #1,128 AS F$:IF LEFT$(F$,1)<>"R" THEN GOTO 600
220 CLOSE:KILL "LENTEST.DAT":KILL "LENMEM.BIN":PRINT "LENGTH PASS":END
500 IF E=0 THEN S=128*INT((S+127)/128)
510 IF LOF(1)=S THEN RETURN
520 PRINT "Expected";S;" got";LOF(1)
600 PRINT "LENGTH FAIL";N:END
