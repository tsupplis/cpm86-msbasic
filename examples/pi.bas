10 PRINT "      BOUNDS ON PI - DOUBLE PRECISION BIONOMIAL THEOREM VERSION"
20 PRINT
30 PRINT" N    SIDES        SIDE LENGTH        PI-LOWER BOUND";
40 PRINT "      PI-UPPER BOUND"
50 REM
60 REM
70 RANGE%=20
80 DEFDBL A-Z
90 SIDES#=4# : SUM#=2# : N%=3
100 SIDES# = 2#*SIDES#
110 SSQ# = SUM#
120 SUM# = 0#
130 TERM# = .25#*SSQ#
140 K#=1#
150 TEMP# = TERM#+SUM#
160 IF TEMP# <= SUM# THEN 220
170 SUM# = TEMP#
180 FACT# = (2#*K#-1#)/(K#+1#)
190 TERM# = FACT#*SSQ#*TERM#/8#
200 K#=K#+1#
210 GOTO 150
220 SLNGTH#=SQR(SUM#)
230 PILOW#=.5#*SIDES#*SLNGTH#
240 PIUP#=SIDES#*SLNGTH#/(2#-SLNGTH#)
250 PRINT USING "##";N%;
260 PRINT USING "##########,    ";SIDES#;
270 PRINT USING "#.##############    ";SLNGTH#;
280 PRINT USING "#.##############    ";PILOW#;
290 PRINT USING "#.##############    ";PIUP#
300 IF N%=RANGE% THEN SYSTEM
310 N%=N%+1
320 GOTO 100
330 END
